---
import { Card, Flex, Text } from '@radix-ui/themes';

interface Props {
    url: string;
    name: string;
    isBig?: boolean;
}

const { url, name, isBig = false } = Astro.props;
const id = url.split('/').at(-2);
const imageSrc = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${ id }.png`;

---
    
<Card asChild>
    <a href={`/pokemons/${name}`} style={{ textDecoration: 'none' }}>
        <Flex direction="column" align="center" justify="center" gap="2" className="p-2">
            <img
                transition:name={`${name}-image`}
                src={imageSrc}
                alt={name}
                width={isBig ? 104 : 64}
                height={isBig ? 104 : 64}
            />
            <Text
                as="span"
                size={isBig ? '5' : '3'}
                className="capitalize text-center"
            >#{id} {name}</Text>
        </Flex>
    </a>
</Card>
